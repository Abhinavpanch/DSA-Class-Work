class Solution {
    private int count = 0;

    public int totalNQueens(int n) {
        backtrack(0, 0, 0, 0, n);
        return count;
    }

    private void backtrack(int row, int cols, int diag1, int diag2, int n) {
        if (row == n) {
            count++;
            return;
        }
        int availableSpots = ((1 << n) - 1) & ~(cols | diag1 | diag2);
        while (availableSpots != 0) {
            int spot = availableSpots & -availableSpots;
            availableSpots -= spot;
            backtrack(row + 1, cols | spot, (diag1 | spot) << 1, (diag2 | spot) >> 1, n);
        }
    }
}
